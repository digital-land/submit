{
  "priority": 5,
  "request": {
    "method": "GET",
    "urlPathPattern": "/dataset/[^/]+\\.json"
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "dataset": "{{regexExtract request.path '/dataset/([^/]+)[.]json' 'datasetPath'}}{{datasetPath.0}}",
      "name": "Generic Dataset",
      "collection": "generic-collection",
      "typology": "geography"
    }
  }
}
