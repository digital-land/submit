SESSION_SECRET=your_secret
SENTRY_DSN=You_DSN
GOVUK_NOTIFY_API_KEY=your_api_key
DATA_MANAGEMENT_EMAIL=data_management_team_email_address
JIRA_URL=your_jira_url
JIRA_API_KEY=your_jira_api_token
JIRA_SERVICE_DESK_ID=your_jira_service_desk_id

# Local startup fills missing keys automatically; never expose the private key to the browser.
AUTH_JWT_PRIVATE_KEY=
SUBMIT_JWT_PUBLIC_KEY=
AUTH_JWT_AUDIENCE=async

# Internal Access client registration. Keep the client secret server-side.
INTERNAL_ACCESS_ISSUER=https://sso.service.security.gov.uk
INTERNAL_ACCESS_CLIENT_ID=
INTERNAL_ACCESS_CLIENT_SECRET=
# Register this exact URL with Internal Access; use the deployed HTTPS origin outside local development.
INTERNAL_ACCESS_CALLBACK_URL=http://localhost:5000/auth/callback
